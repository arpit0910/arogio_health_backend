{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/system-status/public/**/*",
        "watchAssets": true
      },
      {
        "include": "modules/administration/public/**/*",
        "watchAssets": true
      }
    ]
  }
}
