# Used by npm run start:local / start:dev. PGlite storage is .local/database.
NODE_ENV=development
PORT=3001
# Config validation value only; the local runner injects embedded PostgreSQL.
DATABASE_URL=postgresql://local:local@127.0.0.1:5432/arogio_local
DATABASE_POOL_MAX=2
DATABASE_IDLE_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
JWT_ISSUER=arogio-local-api
JWT_AUDIENCE=arogio-local-app
JWT_ACCESS_SECRET=GENERATE_A_SEPARATE_LOCAL_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=987857172312-fil8ani3esi0j9gsg095c6tg1utcbm2j.apps.googleusercontent.com
LOG_LEVEL=warn
SWAGGER_ENABLED=true

# Optional server-side city weather (omit until configured)
# OPENWEATHER_API_KEY=your-provider-key
# Stormglass is optional and takes precedence when set. Free plan is non-commercial.
# STORMGLASS_API_KEY=your-provider-key
# Durable shared directory; do not clear it on restart/deploy (contains quota usage).
# WEATHER_CACHE_DIR=/persistent/arogio/weather

# Used only when explicitly running seed:super-admin. Use a dedicated email.
# SUPER_ADMIN_EMAIL=your-admin-email
# SUPER_ADMIN_PASSWORD=use-a-unique-password-of-at-least-16-characters
# SUPER_ADMIN_NAME=Arogio Super Admin
