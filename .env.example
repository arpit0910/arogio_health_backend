NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres.project-ref:replace-me@region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_ISSUER=arogio-api
JWT_AUDIENCE=arogio-clients
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_IDS=replace-with-google-client-id.apps.googleusercontent.com
LOG_LEVEL=info
SWAGGER_ENABLED=true
